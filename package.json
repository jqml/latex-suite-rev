{
	"name": "latex-suite-rev",
	"version": "0.2.1",
	"description": "Type LaTeX math quickly with snippets, text expansion, and editor enhancements.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node --test tests/**/*.test.mjs",
		"check:json": "node -e \"for (const file of ['manifest.json', 'package.json', 'package-lock.json', 'versions.json', 'vaults.local.example.json']) JSON.parse(require('fs').readFileSync(file, 'utf8'))\"",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "npm run tsc && npm run eslint",
		"tsc": "tsc --noEmit -skipLibCheck",
		"eslint": "eslint ."
	},
	"keywords": [],
	"author": "JQML",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jqml/latex-suite-rev.git"
	},
	"bugs": {
		"url": "https://github.com/jqml/latex-suite-rev/issues"
	},
	"homepage": "https://github.com/jqml/latex-suite-rev#readme",
	"devDependencies": {
		"@codemirror/autocomplete": "^6.0.0",
		"@codemirror/commands": "^6.0.0",
		"@codemirror/lang-javascript": "^6.0.0",
		"@codemirror/language": "https://github.com/lishid/cm-language",
		"@codemirror/lint": "^6.0.0",
		"@codemirror/search": "^6.0.0",
		"@codemirror/state": "^6.0.0",
		"@codemirror/view": "^6.0.0",
		"@eslint/eslintrc": "^3.3.3",
		"@eslint/js": "^9.39.2",
		"@lezer/common": "^1.0.3",
		"@lezer/highlight": "^1.2.3",
		"@types/node": "^22.15.17",
		"@typescript-eslint/eslint-plugin": "^8.55.0",
		"@typescript-eslint/parser": "^8.55.0",
		"codemirror": "^6.0.0",
		"esbuild": "^0.28.1",
		"esbuild-plugin-inline-import": "^1.0.2",
		"eslint": "^9.39.2",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"globals": "^17.3.0",
		"obsidian": "^1.13.1",
		"tslib": "2.3.1",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"valibot": "^1.4.2"
	}
}
